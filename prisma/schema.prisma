// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider        = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// eventualmente aggiungere in futuro ruoli come HR, Commerciale, Team Leader, Area manager, ecc
enum Role {
  ADMIN
  USER
}

model User {
  id                 String       @id @default(nanoid())
  name               String
  lastname           String
  email              String       @unique
  password           String
  mustChangePassword Boolean      @default(true)
  fileId             String? // google drive fileId
  role               Role         @default(USER)
  workProfile        WorkProfile?
  report             Report[]
}

// TODO connettere tramite fk lookup tables (come office, tabelle many to many?)
model WorkProfile {
  id                   String    @id @default(nanoid())
  office               String
  hiringDate           DateTime  @db.Date
  courseFrom           DateTime? @db.Date // YYYY-MM-DD
  courseTo             DateTime? @db.Date
  referencePerson      String?
  programmingLanguages String[] // ["Javascript", "Typescript", "Java"]
  frontendTechnologies String[] // ["Angular", "Angular material", "RxJs", "NgRx", "Vue", "Pinia"]
  backendTechnologies  String[] // ["Spring", "Hibernate"]
  databases            String[] // ["Postgres", "MongoDB"]
  softwareUsed         String[] // ["Visual Studio Code", "Postman", "Eclipse", "Git"]
  foreignLanguages     String[] // ["Inglese|Avanzato", "Spagnolo|Base"]
  userId               String    @unique
  user                 User      @relation(fields: [userId], references: [id])
}

model Report {
  id              String   @id @default(nanoid())
  startDate       DateTime @db.Date // YYYY-MM-DD
  endDate         DateTime @db.Date // YYYY-MM-DD
  activityType    String
  activity        String
  description     String
  referencePerson String
  customer        String
  colleaguesSI    String?
  notes           String?
  createdAt       DateTime @default(now())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
}

model Office {
  id   String @id @default(nanoid())
  name String @unique // Pescara, Teramo, Torino, ecc
}

model ProgrammingLanguages {
  id   String @id @default(nanoid())
  name String @unique // Javascript, Typescript, Java, Python, ecc
}

model FrontendTechnologies {
  id   String @id @default(nanoid())
  name String @unique // Angular, Angular material, Bootstrap, RxJs, NgRx, Vue, Pinia, ecc
}

model BackendTechnologies {
  id   String @id @default(nanoid())
  name String @unique // Spring, Hibernate, Express, ecc
}

model Database {
  id   String @id @default(nanoid())
  name String @unique // Postgres, MySql, MongoDB, ecc
}

model SoftwareUsed {
  id   String @id @default(nanoid())
  name String @unique // Visual Studio Code, Eclipse, Postman, ecc
}

model ForeignLanguageLevel {
  id   String @id @default(nanoid())
  name String @unique // "Inglese|Avanzato", "Inglese|Intermedio", "Inglese|Base", "Spagnolo|Avanzato", ecc
}
